{
  "name": "reckon-workbench",
  "displayName": "reckon",
  "description": "AI-native investigation workbench for threat hunters and IR responders",
  "version": "0.0.1",
  "publisher": "reckon",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/sd-strax/reckon.git",
    "directory": "workbench"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reckon",
          "title": "reckon",
          "icon": "media/reckon.svg"
        }
      ]
    },
    "views": {
      "reckon": [
        {
          "id": "reckon.investigations",
          "name": "Investigations"
        },
        {
          "id": "reckon.cases",
          "name": "Cases"
        },
        {
          "id": "reckon.knowledge",
          "name": "Knowledge"
        },
        {
          "id": "reckon.capabilities",
          "name": "Capabilities",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "reckon.signIn",
        "category": "reckon",
        "title": "Sign In"
      },
      {
        "command": "reckon.signOut",
        "category": "reckon",
        "title": "Sign Out"
      },
      {
        "command": "reckon.setAnthropicKey",
        "category": "reckon",
        "title": "Set Anthropic API Key (BYOK)"
      },
      {
        "command": "reckon.checkBackend",
        "category": "reckon",
        "title": "Check Backend Connection"
      },
      {
        "command": "reckon.openCase",
        "category": "reckon",
        "title": "Open Case"
      },
      {
        "command": "reckon.refreshCases",
        "category": "reckon",
        "title": "Refresh Cases",
        "icon": "$(refresh)"
      },
      {
        "command": "reckon.cases.sortByAge",
        "category": "reckon",
        "title": "Cases: Sort Oldest First",
        "icon": "$(history)"
      },
      {
        "command": "reckon.cases.sortByPriority",
        "category": "reckon",
        "title": "Cases: Sort by Priority, Then Age",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "reckon.refreshInvestigations",
        "category": "reckon",
        "title": "Refresh Investigations",
        "icon": "$(refresh)"
      },
      {
        "command": "reckon.resetAgentContext",
        "category": "reckon",
        "title": "Reset Agent Context (rebuild from investigation record)"
      },
      {
        "command": "reckon.newInvestigation",
        "category": "reckon",
        "title": "New Investigation",
        "icon": "$(add)"
      },
      {
        "command": "reckon.seedFromCase",
        "category": "reckon",
        "title": "Seed Investigation from Case…"
      },
      {
        "command": "reckon.importSOP",
        "category": "reckon",
        "title": "Import SOPs…",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "reckon.openKnowledge",
        "category": "reckon",
        "title": "Open the Knowledge View",
        "icon": "$(book)"
      },
      {
        "command": "reckon.searchKnowledge",
        "category": "reckon",
        "title": "Search Knowledge",
        "icon": "$(search)"
      },
      {
        "command": "reckon.refreshKnowledge",
        "category": "reckon",
        "title": "Refresh Knowledge",
        "icon": "$(refresh)"
      },
      {
        "command": "reckon.openKnowledgeItem",
        "category": "reckon",
        "title": "Open in the Knowledge View"
      },
      {
        "command": "reckon.askToUseKnowledge",
        "category": "reckon",
        "title": "Ask reckon to use this",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "reckon.startInvestigationFromCase",
        "category": "reckon",
        "title": "Start Investigation",
        "icon": "$(play)"
      },
      {
        "command": "reckon.refreshCapabilities",
        "category": "reckon",
        "title": "Refresh Capabilities",
        "icon": "$(refresh)"
      },
      {
        "command": "reckon.setUpCapability",
        "category": "reckon",
        "title": "Set Up…",
        "icon": "$(gear)"
      },
      {
        "command": "reckon.openInvestigation",
        "category": "reckon",
        "title": "Open Investigation"
      },
      {
        "command": "reckon.renameInvestigation",
        "category": "reckon",
        "title": "Rename Investigation…",
        "icon": "$(edit)"
      },
      {
        "command": "reckon.applyPosture",
        "category": "reckon",
        "title": "Apply Workbench Posture"
      },
      {
        "command": "reckon.revertPosture",
        "category": "reckon",
        "title": "Revert Workbench Posture"
      }
    ],
    "keybindings": [
      {
        "command": "reckon.newInvestigation",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      },
      {
        "command": "workbench.view.extension.reckon",
        "key": "ctrl+alt+shift+i",
        "mac": "cmd+alt+shift+i"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "reckon.newInvestigation",
          "when": "view == reckon.investigations && reckon.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "reckon.refreshInvestigations",
          "when": "view == reckon.investigations",
          "group": "navigation@2"
        },
        {
          "command": "reckon.cases.sortByAge",
          "when": "view == reckon.cases && reckon.casesSort != age",
          "group": "navigation@1"
        },
        {
          "command": "reckon.cases.sortByPriority",
          "when": "view == reckon.cases && reckon.casesSort == age",
          "group": "navigation@1"
        },
        {
          "command": "reckon.refreshCases",
          "when": "view == reckon.cases",
          "group": "navigation@2"
        },
        {
          "command": "reckon.searchKnowledge",
          "when": "view == reckon.knowledge && reckon.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "reckon.importSOP",
          "when": "view == reckon.knowledge && reckon.signedIn",
          "group": "navigation@2"
        },
        {
          "command": "reckon.openKnowledge",
          "when": "view == reckon.knowledge && reckon.signedIn",
          "group": "navigation@3"
        },
        {
          "command": "reckon.refreshKnowledge",
          "when": "view == reckon.knowledge",
          "group": "navigation@4"
        },
        {
          "command": "reckon.refreshCapabilities",
          "when": "view == reckon.capabilities",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "reckon.renameInvestigation",
          "when": "view == reckon.investigations && viewItem == reckon.investigation && reckon.signedIn",
          "group": "inline@1"
        },
        {
          "command": "reckon.resetAgentContext",
          "when": "view == reckon.investigations && viewItem == reckon.investigation && reckon.signedIn",
          "group": "context@1"
        },
        {
          "command": "reckon.startInvestigationFromCase",
          "when": "view == reckon.cases && viewItem == reckon.case && reckon.signedIn",
          "group": "inline@1"
        },
        {
          "command": "reckon.askToUseKnowledge",
          "when": "view == reckon.knowledge && viewItem == reckon.knowledgeItem && reckon.signedIn && reckon.investigationStageable",
          "group": "inline@1"
        },
        {
          "command": "reckon.setUpCapability",
          "when": "view == reckon.capabilities && viewItem == reckon.capability.setup && reckon.signedIn",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "reckon.openInvestigation",
          "when": "false"
        },
        {
          "command": "reckon.openCase",
          "when": "false"
        },
        {
          "command": "reckon.cases.sortByAge",
          "when": "false"
        },
        {
          "command": "reckon.cases.sortByPriority",
          "when": "false"
        },
        {
          "command": "reckon.renameInvestigation",
          "when": "false"
        },
        {
          "command": "reckon.resetAgentContext",
          "when": "false"
        },
        {
          "command": "reckon.startInvestigationFromCase",
          "when": "false"
        },
        {
          "command": "reckon.setUpCapability",
          "when": "false"
        },
        {
          "command": "reckon.openKnowledgeItem",
          "when": "false"
        },
        {
          "command": "reckon.askToUseKnowledge",
          "when": "false"
        },
        {
          "command": "reckon.newInvestigation",
          "when": "reckon.signedIn"
        },
        {
          "command": "reckon.seedFromCase",
          "when": "reckon.signedIn"
        },
        {
          "command": "reckon.importSOP",
          "when": "reckon.signedIn"
        },
        {
          "command": "reckon.openKnowledge",
          "when": "reckon.signedIn"
        },
        {
          "command": "reckon.searchKnowledge",
          "when": "reckon.signedIn"
        },
        {
          "command": "reckon.signIn",
          "when": "!reckon.signedIn"
        },
        {
          "command": "reckon.signOut",
          "when": "reckon.signedIn"
        }
      ]
    },
    "configuration": {
      "title": "reckon",
      "properties": {
        "reckon.backendUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Base URL of the locally running reckon backend."
        },
        "reckon.model": {
          "type": "string",
          "default": "claude-opus-4-8",
          "description": "Anthropic model the investigation agent uses (BYOK). Runs against your own API key."
        },
        "reckon.agent.maxToolResultKB": {
          "type": "number",
          "default": 128,
          "minimum": 16,
          "description": "Size in KB one tool result may reach before the agent is shown it a page at a time, with a digest of the whole result. Larger values fill the model's context faster."
        },
        "reckon.agent.contextWindowTokens": {
          "type": "number",
          "default": 200000,
          "minimum": 16000,
          "description": "The model's context window in tokens. The agent condenses older turns when the conversation nears it, and adopts the provider's own limit if a request is refused as too long."
        },
        "reckon.agent.turnTimeoutMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "How long one agent turn may run before it is stopped. What the turn did so far is kept on the record."
        },
        "reckon.sidecarPath": {
          "type": "string",
          "default": "",
          "description": "Path to the reckon binary the workbench spawns as the agent-loop sidecar (`reckon investigate --stdio`). Empty resolves `reckon` on PATH."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && tsc -p webview && node esbuild.mjs",
    "watch": "tsc -watch -p ./",
    "watch:webview": "node esbuild.mjs --watch",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "harness": "node esbuild.mjs --serve",
    "harness:record": "tsc -p harness/tsconfig.record.json && node harness/dist/record/harness/record.js",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vscode-jsonrpc": "^8.2.0"
  }
}
