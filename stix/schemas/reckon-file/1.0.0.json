{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sd-strax/reckon/main/stix/schemas/reckon-file/1.0.0.json",
  "title": "reckon-file",
  "description": "A file's full path, which the STIX file object has no property for.",
  "type": "object",
  "properties": {
    "extension_type": {
      "const": "property-extension"
    },
    "path": {
      "type": "string",
      "description": "The file's full path."
    }
  },
  "required": [
    "extension_type"
  ],
  "additionalProperties": false
}
