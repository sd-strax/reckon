{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sd-strax/reckon/main/stix/schemas/reckon-provenance/1.0.0.json",
  "title": "reckon-provenance",
  "description": "How an evidence object came to be: from which tool, through which normalizer, and whether directly or by inference.",
  "type": "object",
  "properties": {
    "extension_type": {
      "const": "property-extension"
    },
    "derivation_mode": {
      "type": "string",
      "enum": [
        "DIRECT",
        "INFERRED"
      ],
      "description": "Whether the object traces to a direct observation or to an imported inference."
    },
    "tool": {
      "type": "string",
      "description": "The source tool the observation came through."
    },
    "normalizer": {
      "type": "string",
      "description": "The normalizer that produced the object."
    },
    "normalizer_version": {
      "type": "integer",
      "description": "The normalizer's version."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the event was observed."
    }
  },
  "required": [
    "extension_type",
    "derivation_mode",
    "tool",
    "normalizer",
    "normalizer_version",
    "observed_at"
  ],
  "additionalProperties": false
}
