{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sd-strax/reckon/main/stix/schemas/reckon-attestation/1.0.0.json",
  "title": "reckon-attestation",
  "description": "A person's attestation of a prediction's result: which prediction, who was asked, how, and when.",
  "type": "object",
  "properties": {
    "extension_type": {
      "const": "property-extension"
    },
    "prediction_ref": {
      "type": "string",
      "pattern": "^reckon-prediction--[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The prediction the attestation answers."
    },
    "source": {
      "type": "string",
      "description": "Who was asked."
    },
    "channel": {
      "type": "string",
      "description": "How they were asked."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the attested observation happened."
    }
  },
  "required": [
    "extension_type",
    "prediction_ref"
  ],
  "additionalProperties": false
}
