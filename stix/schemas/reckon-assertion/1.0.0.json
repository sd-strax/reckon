{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sd-strax/reckon/main/stix/schemas/reckon-assertion/1.0.0.json",
  "title": "reckon-assertion",
  "description": "A person's assertion of a relationship: who asserted it, when, why, and whether it was withdrawn.",
  "type": "object",
  "properties": {
    "extension_type": {
      "const": "property-extension"
    },
    "asserted_by": {
      "type": "string",
      "description": "The id of the person who asserted the relationship."
    },
    "asserted_by_name": {
      "type": "string",
      "description": "That person's name."
    },
    "asserted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the relationship was asserted."
    },
    "note": {
      "type": "string",
      "description": "Why it was asserted."
    },
    "withdrawn_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the assertion was withdrawn. Absent while it stands."
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "act": {
            "enum": [
              "asserted",
              "withdrawn"
            ]
          },
          "by": {
            "type": "string"
          },
          "by_name": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "act",
          "by",
          "at"
        ],
        "additionalProperties": false
      },
      "description": "Every act on the assertion, in order."
    }
  },
  "required": [
    "extension_type",
    "asserted_by",
    "asserted_at"
  ],
  "additionalProperties": false
}
