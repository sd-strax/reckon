{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sd-strax/reckon/main/stix/schemas/reckon-process/1.0.0.json",
  "title": "reckon-process",
  "description": "A process's name, which the STIX process object has no property for.",
  "type": "object",
  "properties": {
    "extension_type": {
      "const": "property-extension"
    },
    "name": {
      "type": "string",
      "description": "The process's name."
    }
  },
  "required": [
    "extension_type"
  ],
  "additionalProperties": false
}
