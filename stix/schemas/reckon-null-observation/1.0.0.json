{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sd-strax/reckon/main/stix/schemas/reckon-null-observation/1.0.0.json",
  "title": "reckon-null-observation",
  "description": "A null observation: a question asked of a source with complete coverage, to which nothing came back. The STIX common properties come from the STIX 2.1 core schema, so this schema lists only the ones it constrains.",
  "type": "object",
  "properties": {
    "type": {
      "const": "reckon-null-observation"
    },
    "spec_version": {
      "const": "2.1"
    },
    "id": {
      "type": "string",
      "pattern": "^reckon-null-observation--[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object"
    },
    "verb": {
      "type": "string",
      "description": "The question asked."
    },
    "subject": {
      "type": "object",
      "description": "The entity the question was about, as the call named it."
    },
    "parameters": {
      "type": "object",
      "description": "The call's other inputs."
    },
    "window_from": {
      "type": "string",
      "format": "date-time",
      "description": "The start of the window searched."
    },
    "window_to": {
      "type": "string",
      "format": "date-time",
      "description": "The end of the window searched."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The source tools that answered."
    },
    "coverage": {
      "const": "COMPLETE",
      "description": "The coverage of the answer, which is always complete."
    },
    "object_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+--[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "description": "The subject's objects, when its identity is clear from the call alone."
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the question was answered."
    }
  },
  "required": [
    "type",
    "spec_version",
    "id",
    "created",
    "modified",
    "verb",
    "sources",
    "coverage",
    "observed_at"
  ]
}
